# Copy to .env and fill in. Never commit .env.

# Dedicated Gmail account for Dexter (also connected to your phone assistant)
GMAIL_ADDRESS=
# Google app password (myaccount.google.com/apppasswords, needs 2-Step Verification)
GMAIL_APP_PASSWORD=

# Where new projects are created (agents may only work inside this folder)
DEXTER_WORKSPACE=~/Projects

# Optional
# DEXTER_DEFAULT_AGENT=claude
# DEXTER_CLAUDE_PATH=claude
# DEXTER_RUN_TIMEOUT_MINUTES=30
# DEXTER_DATA_DIR=./data
